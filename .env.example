# MCP 默认只监听宿主机 127.0.0.1。通过可信隧道或反向代理远程连接时再改成 0.0.0.0。
MCP_BIND_IP=127.0.0.1
MCP_PORT=5013

# 建议手工填写至少 32 字节随机值。
# 留空时，容器首次启动会自动生成并保存到 arl_mcp_data:/data/token。
MCP_TOKEN=

# true: 仅查询；false: 允许 AI 提交、停止、重启 ARL 任务。
MCP_READ_ONLY=true
MCP_ALLOW_UNAUTHENTICATED=false
MCP_MAX_PAGE_SIZE=200
MCP_LOG_LEVEL=INFO

# 推荐在 config-docker.yaml 的 ARL.API_KEY 中配置同一个长随机值。
# MCP 会优先读取这里，其次读取 config-docker.yaml，再其次使用账号密码登录。
ARL_API_KEY=
ARL_TOKEN=
ARL_USERNAME=
ARL_PASSWORD=

# Docker 内部默认连接 ARL Web 容器。ARL 使用自签名证书，因此默认不校验证书。
ARL_BASE_URL=https://web
ARL_VERIFY_TLS=false
ARL_TIMEOUT=30
