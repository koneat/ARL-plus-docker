# 复制到 /root/arl-full.env，chmod 600 后填写。
# 该文件包含密钥，不要提交到 GitHub。

REPO_URL='https://github.com/koneat/ARL-plus-docker.git'
REPO_BRANCH='main'
ARL_DIR='/root/ARL-plus-docker'

# 生产保护：默认不关闭防火墙。
DISABLE_UFW='false'

# MongoDB 留空使用本地容器；使用 Atlas 时填写完整 URI。
ARL_MONGO_URI=''
ARL_MONGO_DB='arl'

# 留空自动生成；生产建议固定并妥善保存。
ARL_API_KEY=''
MCP_TOKEN=''

MCP_LOCAL_BIND_IP='127.0.0.1'
MCP_LOCAL_PORT='5013'
MCP_ALLOW_LOCAL_UNAUTHENTICATED='true'
MCP_EXTERNAL_BIND_IP='127.0.0.1'
MCP_EXTERNAL_PORT='5014'
MCP_READ_ONLY='true'

ARL_BIND_IP='0.0.0.0'
ARL_HTTPS_PORT='5003'

# 持久化自定义镜像。服务切换成功后，具体运行镜像会写入仓库 .env。
ARL_BASE_IMAGE='ki9mu/arl-ki9mu:v3.0.1'
ARL_ENHANCED_WORKER_IMAGE='arl-enhanced-worker:v3.0.1-2026.07'
ARL_PROXY_RUNTIME_IMAGE='arl-proxy-runtime:v3.0.1-2026.07'

FOFA_EMAIL=''
FOFA_KEY=''
HUNTER_API_KEY=''
QUAKE_TOKEN=''
ZOOMEYE_API_KEY=''
SHODAN_API_KEY=''
GITHUB_TOKEN=''

ENABLE_SMART_WILDCARD='true'
ENABLE_SCANNER_STACK='true'
BUILD_SCANNER_IMAGE='true'

ENABLE_VLESS_PROXY='false'
ENABLE_ARL_HTTP_PROXY='false'
FORCE_ARL_PROXY='false'
XRAY_CORE_VERSION='v26.3.27'
XRAY_SOCKS_PORT='1080'
VLESS_NODES_FILE='/etc/xray-core/vless-nodes.txt'

# 必须与自动 Afrog 联动同时开启：Afrog 的 HTTP 请求通过该代理，由 xray 分析。
ENABLE_CHAITIN_XRAY='true'
CHAITIN_XRAY_VERSION='1.9.11'
CHAITIN_XRAY_PORT='7777'

# 构建持久化增强 Worker，并把 Afrog 真正挂到 ARL 任务流。
ENABLE_WORKER_EXTENSIONS='true'
INSTALL_CHROMIUM='true'
AFROG_VERSION='v3.5.3'
RAD_VERSION='1.0'
REPORT_ROOT='/var/lib/arl-reports'
REPORT_WORLD_READABLE='false'

# 自动任务联动：未执行、失败、零命中、有命中会分别记录。
ARL_AUTO_AFROG_SCAN='true'
ARL_REQUIRE_XRAY_PROXY='true'
ARL_AFROG_SEVERITY='info,low,medium,high,critical'
ARL_AFROG_RATE_LIMIT='100'
ARL_AFROG_CONCURRENCY='20'
ARL_AFROG_TIMEOUT='20'
ARL_AFROG_MAX_TARGETS='3000'

AFROG_CALLBACK_DOMAIN='callback.red'
AFROG_CALLBACK_API_URL='http://callback.red'

# ARL 内置 Nuclei 策略。默认排除 DoS、侵入式、暴力和高噪声 fuzz 模板。
ARL_NUCLEI_TAGS='cve,exposure,config,files,backup,token,logs,debug,misconfig,api,swagger,openapi,graphql,webhook'
ARL_NUCLEI_SEVERITY='info,low,medium,high,critical'
ARL_NUCLEI_EXCLUDE_TAGS='dos,fuzz,intrusive,bruteforce'
ARL_NUCLEI_RATE_LIMIT='120'
